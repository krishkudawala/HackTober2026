# Application Settings
APP_NAME=KavachX Bharat API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security, CORS & Authentication (B06)
# Comma-separated list of allowed origins or "*" for open local development.
# In production (ENVIRONMENT=production), wildcard "*" is rejected if credentials are enabled.
CORS_ORIGINS=*
# Allow cookies and credentials across origins (true/false)
CORS_ALLOW_CREDENTIALS=true

# Optional Server-to-Server API Key (B06)
# When set, protected /api/* endpoints require 'X-API-Key' or 'Authorization: Bearer <key>'.
# Leave commented or empty for local development (unauthenticated access).
# NOTE: Embedding this key in a client-side mobile app (e.g. Flutter) does NOT protect against reverse engineering.
# API_KEY=your_private_server_key_here

# AI Provider Configuration
# Supported: fallback (default rule-based), litert, ollama
AI_PROVIDER=fallback

# Optional: LiteRT model path (when using AI_PROVIDER=litert)
# LITERT_MODEL_PATH=path/to/gemma-4-E4B-it.litertlm

# Optional: Ollama settings (when using AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# Speech-to-Text (STT) Configuration
# Supported: demo (default: zero credentials required, prompts manual transcript paste)
STT_PROVIDER=demo
# Maximum audio file upload size in bytes (25MB = 26214400 bytes)
MAX_AUDIO_UPLOAD_BYTES=26214400

# Durable Storage Configuration (B05)
# Relative path to SQLite database file. Defaults to data/kavachx.db
# Note: The database file contains user-submitted scan content and incident report metadata.
# The local database file must be secured and protected by the host deployment environment.
DATABASE_PATH=data/kavachx.db
